class Solution {
    public int maxProfit(int[] prices) {
        int max=-1;
        int c=0;
        for(int i=prices.length-1;i>=0;i--){
            if(prices[i]>max){
                max=prices[i];
            }
            else{
                int s=max-prices[i];
                if(c<s){
                    c=s;
                }
            }
        }
        return c;
    }
}
