class Solution {
    public int[] replaceElements(int[] arr) {
        for(int i=0;i<arr.length;i++){
            int max=0;
            for(int j=i+1;j<arr.length;j++){
                if(arr[j]>max){
                    max=arr[j];
                }
            }
            arr[i]=max;
        }
        arr[arr.length-1]=-1;
        return arr;
    }
}

the above code is not optimized. brute force


Optimized solution

class Solution {
    public int[] replaceElements(int[] arr) {
        int max=-1;
        int c;
        for(int i=arr.length-1;i>=0;i--){
                c=arr[i];
                arr[i]=max;
                if(c>max){
                    max=c;
                }
        }
        return arr;
    }
}
