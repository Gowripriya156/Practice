class Solution {
    public int[] twoSum(int[] num, int target) {
        int j=num.length-1;
        int sum=0;
        int i=0;
        int[] res=new int[2];
        while(i<=j){
            sum=num[i]+num[j];
            if(sum==target){
                res[0]=i+1;
                res[1]=j+1;
                break;
            }
            else if(sum>target){
                j--;
            }
            else{
                i++;
            }
        }
        return res;
    }
}
