int minAddToMakeValid(char* s) {
    int open=0;
    int add=0;
    for(int i=0;s[i]!='\0';i++){
        if(s[i]=='('){
            open++;
            add++;
        }
        if(s[i]==')'){
            if(add>0){
                open--;
                add--;
            }
            else{
                open++;
            }
        }
    }
    return open;
}
